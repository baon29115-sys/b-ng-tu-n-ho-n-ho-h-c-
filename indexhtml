      { q: "Nguyên tố có 3 lớp electron và 6 electron lớp ngoài cùng là nguyên tố nào?", opts: ["S", "O", "Cl", "P"], c: 0, exp: "Có 3 lớp electron nên thuộc chu kỳ 3; có 6 electron ngoài cùng nên thuộc nhóm VIA. Đó là sulfur (S)." },
      { q: "Nguyên tử X có cấu hình [Ne] 3s² 3p¹. Công thức chloride thông thường của X là gì?", opts: ["XCl", "XCl₂", "XCl₄", "XCl₃"], c: 3, exp: "X là Al, thường có số oxi hóa +3 trong hợp chất. Với Cl có số oxi hóa −1, chloride là AlCl₃, tức XCl₃." }
    ];
        const QUIZ_QUESTIONS = QUIZ_TOPICS.map(base => {
            return {
                q: base.q,
                options: base.opts.map((option, optionIndex) => `${String.fromCharCode(65 + optionIndex)}. ${option}`),
                correct: base.c,
                explain: base.exp
            };
        });

        let currentQuizIndex = 0;
        let selectedAnswers = {};

        function initQuiz() {
            currentQuizIndex = 0;
            selectedAnswers = {};
            renderQuizQuestion();
        }

        function renderQuizQuestion() {
            const q = QUIZ_QUESTIONS[currentQuizIndex];
            document.getElementById('quiz-question-text').innerText = `${currentQuizIndex + 1}. ${q.q}`;
            document.getElementById('quiz-progress-badge').innerText = `Câu ${currentQuizIndex + 1} / ${QUIZ_QUESTIONS.length}`;

            const container = document.getElementById('quiz-options-container');
            container.innerHTML = '';

            const expBox = document.getElementById('quiz-explanation');
            expBox.classList.add('hidden');

            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.onclick = () => selectQuizAnswer(idx);

                let btnStyle = "bg-slate-50 border-slate-200 text-slate-700 hover:bg-indigo-50 hover:border-indigo-300";

                if (selectedAnswers[currentQuizIndex] !== undefined) {
                    if (idx === q.correct) {
                        btnStyle = "bg-emerald-100 border-emerald-400 text-emerald-900 font-bold";
                    } else if (idx === selectedAnswers[currentQuizIndex]) {
                        btnStyle = "bg-rose-100 border-rose-400 text-rose-900 font-bold";
                    }
                }

                btn.className = `w-full text-left p-3.5 rounded-xl border font-medium text-xs transition-all ${btnStyle}`;
                btn.innerText = opt;
                container.appendChild(btn);
            });

            if (selectedAnswers[currentQuizIndex] !== undefined) {
                expBox.classList.remove('hidden');
                const isCorrect = selectedAnswers[currentQuizIndex] === q.correct;
                document.getElementById('quiz-explain-status').innerText = isCorrect ? "🎉 Bạn đã trả lời ĐÚNG!" : "❌ Trả lời CHƯA ĐÚNG!";
                document.getElementById('quiz-explain-status').className = isCorrect ? "font-bold text-emerald-700" : "font-bold text-rose-700";
                document.getElementById('quiz-explain-text').innerText = q.explain;
            }

            document.getElementById('btn-quiz-prev').disabled = currentQuizIndex === 0;
            document.getElementById('btn-quiz-next').innerText = currentQuizIndex === QUIZ_QUESTIONS.length - 1 ? "Hoàn Thành 🏁" : "Câu Tiếp ►";
        }

        function selectQuizAnswer(idx) {
            if (selectedAnswers[currentQuizIndex] !== undefined) return;
            selectedAnswers[currentQuizIndex] = idx;
            renderQuizQuestion();
        }

        function prevQuizQuestion() {
            if (currentQuizIndex > 0) {
                currentQuizIndex--;
                renderQuizQuestion();
            }
        }

        function nextQuizQuestion() {
            if (currentQuizIndex < QUIZ_QUESTIONS.length - 1) {
                currentQuizIndex++;
                renderQuizQuestion();
            } else {
                alert("🎉 Chúc mừng bạn đã hoàn thành bài luyện tập trắc nghiệm 7 chu kỳ!");
            }
        }

        /* KHỞI CHẠY KHỔI ĐẦU */
        window.onload = function() {
            updateCompareTab();
        };
    </script>
