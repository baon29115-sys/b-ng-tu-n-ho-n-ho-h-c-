      { q: "Hydroxide nào sau đây có tính lưỡng tính?", opts: ["NaOH", "KOH", "Ca(OH)₂", "Al(OH)₃"], c: 3, exp: "Al(OH)₃ phản ứng được với acid và với dung dịch base mạnh, nên có tính lưỡng tính." },
      { q: "SO₃ phản ứng với nước tạo ra chất nào?", opts: ["H₂SO₃", "H₂SO₄", "H₂S", "Na₂SO₄"], c: 1, exp: "SO₃ là oxide acid tương ứng với sulfuric acid: SO₃ + H₂O → H₂SO₄." },
