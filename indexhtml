                        </span>
                    </div>
                </div>

                <!-- BỘ CHỌN NHANH -->
                <div class="flex items-center gap-2 flex-wrap text-xs">
                    <span class="font-bold text-slate-400 uppercase">Gợi ý so sánh nhanh:</span>
                    <button onclick="applyPreset(['Li','Na','K','Rb','Cs','Fr'])" class="font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 px-2.5 py-1 rounded-md transition-colors">Nhóm IA (Kiềm Cả 7 CK)</button>
                    <button onclick="applyPreset(['Be','Mg','Ca','Sr','Ba','Ra'])" class="font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 px-2.5 py-1 rounded-md transition-colors">Nhóm IIA (Kiềm Thổ)</button>
                    <button onclick="applyPreset(['F','Cl','Br','I','At','Ts'])" class="font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 px-2.5 py-1 rounded-md transition-colors">Nhóm VIIA (Halogen)</button>
                    <button onclick="applyPreset(['Na','Mg','Al','Si','P','S','Cl'])" class="font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 px-2.5 py-1 rounded-md transition-colors">Trọn Chu kỳ 3</button>
                    <button onclick="applyPreset(['Na','Mg','K','Cs','Fr'])" class="font-bold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 px-2.5 py-1 rounded-md transition-colors">⭐ Chéo Đa Chu Kỳ (Na-Mg-K-Cs-Fr)</button>
                </div>

                <!-- LƯỚI BẢNG TUẦN HOÀN 7 CHU KỲ NHÓM A -->
                <div class="overflow-x-auto custom-scrollbar pt-1 pb-2">
                    <div class="min-w-[760px] space-y-1">
                        <!-- HEADER CÁC NHÓM A -->
                        <div class="grid grid-cols-9 gap-1 text-center text-[11px] font-extrabold text-slate-500 mb-1">
                            <div class="py-1">CK \ Nhóm</div>
                            <div class="py-1 bg-blue-50 text-blue-700 rounded-md">IA</div>
                            <div class="py-1 bg-blue-50 text-blue-700 rounded-md">IIA</div>
                            <div class="py-1 bg-amber-50 text-amber-700 rounded-md">IIIA</div>
                            <div class="py-1 bg-amber-50 text-amber-700 rounded-md">IVA</div>
                            <div class="py-1 bg-amber-50 text-amber-700 rounded-md">VA</div>
                            <div class="py-1 bg-amber-50 text-amber-700 rounded-md">VIA</div>
                            <div class="py-1 bg-emerald-50 text-emerald-700 rounded-md">VIIA</div>
                            <div class="py-1 bg-slate-200 text-slate-700 rounded-md">VIIIA</div>
                        </div>

                        <!-- BODY 7 CHU KỲ -->
                        <div id="full-ptable" class="space-y-1">
                            <!-- Rendered by JS -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- KẾT QUẢ SO SÁNH & PHÂN TÍCH -->
            <div id="compare-results" class="space-y-6">

                <!-- 1. GIẢI THÍCH QUY LUẬT BẢN CHẤT -->
                <div class="bg-gradient-to-r from-indigo-900 via-indigo-800 to-slate-900 text-white rounded-2xl p-5 shadow-sm space-y-2">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">✨</span>
                        <h3 class="text-base font-extrabold text-amber-300 uppercase tracking-wider">Phân Tích Bản Chất Quy Luật Tuần Hoàn</h3>
                    </div>
                    <h4 id="relation-title" class="text-lg font-black text-white">...</h4>
                    <p id="relation-desc" class="text-xs sm:text-sm text-indigo-100 leading-relaxed font-light"></p>
                </div>

                <!-- 2. CẤU HÌNH ELECTRON VÀ NGUYÊN TỬ -->
                <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
                    <h3 class="font-extrabold text-slate-800 text-base flex items-center gap-2 border-b border-slate-100 pb-2">
                        <span>⚡</span> Cấu Hình Electron & Lớp Electron Hóa Trị
                    </h3>
                    <div id="electron-cards-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                        <!-- Rendered by JS -->
                    </div>
                </div>

                <!-- 3. BIỂU ĐỒ TRỰC QUAN (CSS BAR CHARTS) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- BÁN KÍNH -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
                        <div class="flex justify-between items-center border-b border-slate-100 pb-2">
                            <h4 class="font-extrabold text-slate-800 text-sm flex items-center gap-1.5">
                                📏 Bán Kính Nguyên Tử (pm)
                            </h4>
                            <span class="text-[10px] text-slate-400 font-medium">Càng dài = Bán kính càng lớn</span>
                        </div>
                        <div id="chart-radius-css" class="space-y-2 pt-1">
                            <!-- Rendered by JS -->
                        </div>
                    </div>

                    <!-- ĐỘ ÂM ĐIỆN -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
                        <div class="flex justify-between items-center border-b border-slate-100 pb-2">
                            <h4 class="font-extrabold text-slate-800 text-sm flex items-center gap-1.5">
                                ⚡ Độ Âm Điện (Pauling)
                            </h4>
                            <span class="text-[10px] text-slate-400 font-medium">Càng dài = Lực hút e càng mạnh</span>
                        </div>
                        <div id="chart-electro-css" class="space-y-2 pt-1">
                            <!-- Rendered by JS -->
                        </div>
                    </div>
                </div>

                <!-- 4. BẢNG TÍNH CHẤT NGUYÊN TỐ, OXIDE & HYDROXIDE -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-4 border-b border-slate-100 font-extrabold text-slate-800 text-base">
                        🧪 Bảng So Sánh Chi Tiết Tính Chất, Oxide Cao Nhất & Hydroxide
                    </div>
                    <div class="overflow-x-auto custom-scrollbar">
                        <table class="w-full text-xs text-left border-collapse min-w-[700px]">
                            <thead class="bg-slate-50 font-bold text-slate-600 uppercase border-b border-slate-200">
                                <tr>
                                    <th class="p-3">Nguyên tố</th>
                                    <th class="p-3">Vị trí</th>
                                    <th class="p-3">Đặc tính</th>
                                    <th class="p-3">Oxide Cao Nhất</th>
                                    <th class="p-3">Hydroxide Tương Ứng</th>
                                    <th class="p-3">Tính Acid / Base</th>
                                </tr>
                            </thead>
                            <tbody id="compare-table-body" class="divide-y divide-slate-100">
                                <!-- Rendered by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </section>

        <!-- ==================== TAB 2: TRÒ CHƠI SẮP XẾP ==================== -->
        <section id="tab-game" class="hidden space-y-6 max-w-4xl mx-auto">
            <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-6">
                
                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 border-b border-slate-100 pb-4">
                    <div>
                        <span class="px-3 py-1 bg-amber-100 text-amber-800 font-extrabold text-xs rounded-full">TRÒ CHƠI KÉO / DỊCH CHUYỂN</span>
                        <h2 class="text-xl font-black text-slate-800 mt-1">Sắp Xếp Thứ Tự Quy Luật Tuần Hoàn</h2>
                        <p class="text-xs text-slate-500 font-medium">Nhấn nút ◄ Trái hoặc Phải ► để thay đổi vị trí các thẻ nguyên tố!</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="bg-amber-50 border border-amber-200 px-4 py-2 rounded-xl text-center">
                            <span class="text-[10px] text-amber-700 font-bold block">ĐIỂM SỐ</span>
                            <span id="game-score" class="text-xl font-black text-amber-600">0</span>
                        </div>
                        <button onclick="initGameRound()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-4 py-2.5 rounded-xl text-xs shadow-sm transition-colors">
                            🔄 Đổi Đề Mới
                        </button>
                    </div>
                </div>

                <!-- ĐỀ BÀI -->
                <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-center space-y-1">
                    <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Yêu cầu đề bài:</span>
                    <h3 id="game-prompt" class="text-base font-extrabold text-indigo-950">
                        ...
                    </h3>
                </div>

                <!-- DANH SÁCH THẺ THAO TÁC DỄ DÀNG -->
                <div id="game-cards-container" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    <!-- Rendered by JS -->
                </div>

                <!-- ACTION BUTTONS -->
                <div class="flex flex-col items-center space-y-3 pt-2">
                    <div class="flex gap-3">
                        <button onclick="showGameHint()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs transition-colors">
                            💡 Xem Gợi Ý
                        </button>
                        <button onclick="checkGameAnswer()" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold rounded-xl text-sm shadow-md transition-all">
                            ✅ KIỂM TRA ĐÁP ÁN
                        </button>
                    </div>

                    <div id="game-result-box" class="hidden w-full p-4 rounded-xl text-xs font-bold text-center space-y-1">
                        <!-- Rendered by JS -->
                    </div>
                </div>

            </div>
        </section>

        <!-- ==================== TAB 3: TRẮC NGHIỆM ==================== -->
        <section id="tab-quiz" class="hidden space-y-6 max-w-3xl mx-auto">
            <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-6">
                
                <div class="flex justify-between items-center border-b border-slate-100 pb-4">
                    <div>
                        <span class="px-3 py-1 bg-indigo-100 text-indigo-800 font-extrabold text-xs rounded-full">TRẮC NGHIỆM</span>
                        <h2 class="text-lg font-black text-slate-800 mt-1">Luyện Tập Kiểm Tra Kiến Thức</h2>
                    </div>
                    <span id="quiz-progress-badge" class="text-xs font-bold bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg border border-slate-200">
                        Câu 1 / 5
                    </span>
                </div>

                <div class="space-y-4">
                    <h3 id="quiz-question-text" class="text-base font-extrabold text-slate-800 leading-snug">
                        ...
                    </h3>

                    <div id="quiz-options-container" class="space-y-2.5">
                        <!-- Rendered by JS -->
                    </div>
                </div>

                <div id="quiz-explanation" class="hidden bg-slate-50 border border-slate-200 p-4 rounded-xl text-xs space-y-1">
                    <div class="font-bold text-slate-800" id="quiz-explain-status"></div>
                    <p class="text-slate-600 leading-relaxed" id="quiz-explain-text"></p>
                </div>

                <div class="flex justify-between items-center pt-2">
                    <button onclick="prevQuizQuestion()" id="btn-quiz-prev" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs">
                        ◄ Câu Trước
                    </button>
                    <button onclick="nextQuizQuestion()" id="btn-quiz-next" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-xs">
                        Câu Tiếp ►
                    </button>
                </div>

            </div>
        </section>

        <!-- HỘ CHIẾU CỦA 20 NGUYÊN TỐ ĐẦU TIÊN -->
        <section id="tab-passport" class="hidden space-y-5" aria-labelledby="passport-heading">
            <div>
                <p class="text-xs font-bold text-indigo-600 uppercase tracking-widest mb-2">Khám phá từ H đến Ca</p>
                <h2 id="passport-heading" class="text-2xl sm:text-3xl font-extrabold text-slate-800">Hộ chiếu nguyên tố</h2>
                <p class="text-sm text-slate-500 mt-2">Chọn một trong 20 nguyên tố đầu tiên để xem hộ chiếu và khám phá đặc điểm, tính chất, ứng dụng.</p>
            </div>
            <div class="passport-layout">
                <div class="passport-panel">
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <h3 class="text-sm font-extrabold">Chọn nguyên tố</h3>
                        <span class="text-xs text-slate-500">Số hiệu 1–20</span>
                    </div>
                    <div id="passport-elements" class="passport-grid" role="group" aria-label="20 nguyên tố đầu tiên"></div>
                    <p class="text-xs text-slate-500 mt-4 leading-relaxed">Số nhỏ phía trên ký hiệu là số hiệu nguyên tử. Ô màu tím là nguyên tố đang xem.</p>
                </div>
                <article id="passport-viewer" class="passport-panel passport-viewer" aria-labelledby="passport-element-title">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div aria-live="polite" aria-atomic="true">
                            <p id="passport-position" class="text-xs font-bold text-indigo-600 mb-1"></p>
                            <h3 id="passport-element-title" class="text-xl font-extrabold"></h3>
                        </div>
                    </div>
                    <dl class="passport-facts">
                        <div><dt>Nhóm</dt><dd id="passport-group"></dd></div>
                        <div><dt>Chu kỳ</dt><dd id="passport-period"></dd></div>
                        <div><dt>Phân loại</dt><dd id="passport-type"></dd></div>
                    </dl>
                    <figure class="bg-slate-50 rounded-xl p-1 sm:p-3 border border-slate-100">
                        <img id="passport-image" class="passport-image" decoding="async" alt="">
                        <figcaption class="text-center text-xs text-slate-500 px-2 pt-3 pb-2">Ảnh hộ chiếu từ tài liệu HỘ CHIẾU NGUYÊN TỐ.</figcaption>
                    </figure>
                    <div class="flex justify-between gap-3 mt-4">
                        <button id="passport-prev" class="passport-action" onclick="stepPassport(-1)">← Nguyên tố trước</button>
                        <button id="passport-next" class="passport-action" onclick="stepPassport(1)">Nguyên tố tiếp →</button>
                    </div>
                </article>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="bg-white border-t border-slate-200 py-3 text-center text-xs text-slate-400 font-medium">
        ChemCompare Pro 7P - Dữ liệu Bảng Tuần Hoàn Nhóm A Chu Kỳ 1 đến 7.
    </footer>

    <!-- JS LOGIC DATABASES & ALGORITHMS -->
    <script>
        /* ==========================================================================
           DATABASE 7 CHU KỲ TẤT CẢ CÁC NGUYÊN TỐ NHÓM A (IA - VIIIA)
           ========================================================================== */
        const MAIN_ELEMENTS = {
