        let currentGameQuestion = null;
        let gameCurrentElements = [];
        let gameScore = 0;

        function initGameRound() {
            const randomIndex = Math.floor(Math.random() * GAME_QUESTIONS.length);
            currentGameQuestion = GAME_QUESTIONS[randomIndex];
            gameCurrentElements = [...currentGameQuestion.elements].sort(() => Math.random() - 0.5);

            document.getElementById('game-prompt').innerText = currentGameQuestion.prompt;
            document.getElementById('game-result-box').classList.add('hidden');

            renderGameCards();
        }

        function moveGameCard(index, direction) {
            const newIndex = index + direction;
            if (newIndex < 0 || newIndex >= gameCurrentElements.length) return;

            const temp = gameCurrentElements[index];
            gameCurrentElements[index] = gameCurrentElements[newIndex];
            gameCurrentElements[newIndex] = temp;

            renderGameCards();
            document.getElementById('game-result-box').classList.add('hidden');
        }

        function renderGameCards(validatedStatus = null) {
            const container = document.getElementById('game-cards-container');
            container.innerHTML = '';

            gameCurrentElements.forEach((sym, idx) => {
                const el = MAIN_ELEMENTS[sym];
                const card = document.createElement('div');

                let statusBorder = "border-slate-200 bg-white";
                let statusBadge = "";

                if (validatedStatus) {
                    if (validatedStatus[idx]) {
                        statusBorder = "border-emerald-500 bg-emerald-50 ring-2 ring-emerald-200";
                        statusBadge = `<span class="text-[9px] font-black text-emerald-700 bg-emerald-200 px-1.5 py-0.5 rounded">✅ Đúng</span>`;
                    } else {
                        statusBorder = "border-rose-500 bg-rose-50 ring-2 ring-rose-200";
                        statusBadge = `<span class="text-[9px] font-black text-rose-700 bg-rose-200 px-1.5 py-0.5 rounded">❌ Sai</span>`;
                    }
                }

                card.className = `p-3.5 rounded-2xl border ${statusBorder} flex flex-col justify-between items-center space-y-2 shadow-sm transition-all`;

                card.innerHTML = `
                    <div class="flex justify-between items-center w-full">
                        <span class="text-[10px] font-black text-slate-400">Vị trí ${idx + 1}</span>
