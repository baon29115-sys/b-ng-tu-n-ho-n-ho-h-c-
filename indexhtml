                    <div class="flex items-center gap-1.5 w-full pt-1">
                        <button onclick="moveGameCard(${idx}, -1)" ${idx === 0 ? 'disabled' : ''} class="flex-1 py-1.5 bg-slate-100 hover:bg-indigo-100 hover:text-indigo-700 disabled:opacity-30 text-slate-700 font-extrabold rounded-lg text-xs transition-colors">
                            ◄ Trái
                        </button>
                        <button onclick="moveGameCard(${idx}, 1)" ${idx === gameCurrentElements.length - 1 ? 'disabled' : ''} class="flex-1 py-1.5 bg-slate-100 hover:bg-indigo-100 hover:text-indigo-700 disabled:opacity-30 text-slate-700 font-extrabold rounded-lg text-xs transition-colors">
                            Phải ►
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function checkGameAnswer() {
            const targetProp = currentGameQuestion.prop;
            const mode = currentGameQuestion.mode;

            const correctSorted = [...gameCurrentElements].sort((a, b) => {
                const valA = MAIN_ELEMENTS[a][targetProp];
                const valB = MAIN_ELEMENTS[b][targetProp];
                return mode === 'asc' ? valA - valB : valB - valA;
            });

            const status = gameCurrentElements.map((sym, idx) => sym === correctSorted[idx]);
            const isAllCorrect = status.every(s => s === true);

            renderGameCards(status);

            const resultBox = document.getElementById('game-result-box');
            resultBox.classList.remove('hidden');

            if (isAllCorrect) {
                gameScore += 10;
                document.getElementById('game-score').innerText = gameScore;
                resultBox.className = "w-full p-3.5 rounded-xl text-xs font-extrabold text-center bg-emerald-100 text-emerald-800 border border-emerald-300";
                resultBox.innerHTML = `🎉 XIN CHÚC MỪNG! Bạn đã sắp xếp chính xác 100%! (+10 điểm)`;
            } else {
                resultBox.className = "w-full p-3.5 rounded-xl text-xs font-extrabold text-center bg-rose-100 text-rose-800 border border-rose-300";
                resultBox.innerHTML = `⚠️ Chưa chính xác. Vui lòng di chuyển lại các thẻ bị đánh dấu đỏ!`;
            }
        }

