        /* ==========================================================================
           TAB SWITCHING
           ========================================================================== */
        function switchTab(tabId) {
            document.querySelectorAll('section[id^="tab-"]').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = "tab-btn px-3.5 py-1.5 rounded-lg font-bold text-xs sm:text-sm text-indigo-100 hover:text-white transition-all flex items-center gap-1.5";
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-btn-${tabId}`);
            activeBtn.className = "tab-btn px-3.5 py-1.5 rounded-lg font-bold text-xs sm:text-sm bg-white text-indigo-800 shadow-sm transition-all flex items-center gap-1.5";

            if (tabId === 'game' && gameCurrentElements.length === 0) {
                initGameRound();
            } else if (tabId === 'quiz' && document.getElementById('quiz-options-container').children.length === 0) {
                initQuiz();
            } else if (tabId === 'passport' && document.getElementById('passport-elements').children.length === 0) {
                initPassports();
            }
        }

        const PASSPORT_ELEMENTS = ["H", "He", "Li", "Be", "B", "C", "N", "O", "F", "Ne", "Na", "Mg", "Al", "Si", "P", "S", "Cl", "Ar", "K", "Ca"];
        let currentPassportIndex = 0;

        function initPassports() {
            const container = document.getElementById('passport-elements');
            PASSPORT_ELEMENTS.forEach((symbol, index) => {
                const element = MAIN_ELEMENTS[symbol];
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'passport-choice';
                button.setAttribute('aria-label', `${element.z}. ${element.name} (${symbol})`);
                button.setAttribute('aria-pressed', 'false');
                button.setAttribute('aria-controls', 'passport-viewer');
                button.innerHTML = `<span class="passport-number">${element.z}</span><span class="passport-symbol">${symbol}</span><span class="passport-name">${element.name}</span>`;
                button.onclick = () => selectPassport(index, true);
                container.appendChild(button);
            });
            selectPassport(currentPassportIndex);
        }

        function selectPassport(index, scrollToPassport = false) {
            if (index < 0 || index >= PASSPORT_ELEMENTS.length) return;
            currentPassportIndex = index;
            const symbol = PASSPORT_ELEMENTS[index];
            const element = MAIN_ELEMENTS[symbol];
            const imagePath = `assets/passports/${symbol}.jpg`;
            document.querySelectorAll('#passport-elements button').forEach((button, buttonIndex) => {
                button.setAttribute('aria-pressed', String(buttonIndex === index));
            });
            document.getElementById('passport-position').textContent = `Hộ chiếu ${index + 1} / ${PASSPORT_ELEMENTS.length} · Z = ${element.z}`;
            document.getElementById('passport-element-title').textContent = `${symbol} · ${element.name}`;
            document.getElementById('passport-group').textContent = element.group;
            document.getElementById('passport-period').textContent = element.period;
            document.getElementById('passport-type').textContent = element.type;
            const image = document.getElementById('passport-image');
            image.alt = `Hộ chiếu nguyên tố ${element.name} (${symbol}), số hiệu nguyên tử ${element.z}`;
            image.src = imagePath;
            document.getElementById('passport-prev').disabled = index === 0;
            document.getElementById('passport-next').disabled = index === PASSPORT_ELEMENTS.length - 1;
            if (scrollToPassport && window.matchMedia('(max-width: 767px)').matches) {
                document.getElementById('passport-viewer').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function stepPassport(direction) {
            selectPassport(currentPassportIndex + direction);
        }

        /* ==========================================================================
           RENDER FULL 7 PERIODS TABLE
           ========================================================================== */
        function renderFullPTable() {
            const container = document.getElementById('full-ptable');
            container.innerHTML = '';

            PTABLE_7P_LAYOUT.forEach(row => {
                const rowDiv = document.createElement('div');
                rowDiv.className = "grid grid-cols-9 gap-1 items-center";

                // Nhãn Chu kỳ
                const pLabel = document.createElement('div');
                pLabel.className = "text-center font-extrabold text-xs text-indigo-700 bg-slate-200/70 py-2 rounded-md border border-slate-300";
                pLabel.innerText = `CK ${row.period}`;
                rowDiv.appendChild(pLabel);

                row.elements.forEach(sym => {
                    if (!sym) {
                        const emptyCell = document.createElement('div');
                        emptyCell.className = "h-11 bg-slate-50/50 rounded-lg border border-dashed border-slate-200/60";
                        rowDiv.appendChild(emptyCell);
                    } else {
                        const el = MAIN_ELEMENTS[sym];
                        const isSelected = selectedElements.includes(sym);
                        const cell = document.createElement('button');
                        cell.onclick = () => toggleElement(sym);

                        let typeBg = "bg-blue-50 border-blue-200 text-blue-900";
                        if (el.type.includes("Phi kim")) typeBg = "bg-emerald-50 border-emerald-200 text-emerald-900";
                        if (el.type.includes("Bán kim")) typeBg = "bg-amber-50 border-amber-200 text-amber-900";
                        if (el.type.includes("Khí hiếm")) typeBg = "bg-slate-100 border-slate-300 text-slate-700";
                        if (el.type.includes("phóng xạ") || el.type.includes("nhân tạo")) typeBg = "bg-purple-50 border-purple-200 text-purple-900";

                        cell.className = `h-11 p-1 rounded-lg border flex flex-col justify-between items-center transition-all ${
                            isSelected 
                            ? 'bg-indigo-600 border-indigo-700 text-white shadow-md ring-2 ring-indigo-300 scale-105 z-10' 
                            : `${typeBg} hover:border-indigo-400 hover:scale-95`
                        }`;

                        cell.innerHTML = `
                            <span class="text-[8px] ${isSelected ? 'text-indigo-200' : 'text-slate-400'} font-extrabold leading-none">${el.z}</span>
                            <span class="text-xs font-black leading-none">${sym}</span>
                            <span class="text-[8px] ${isSelected ? 'text-indigo-200' : 'text-slate-500'} font-semibold leading-none">${el.group}</span>
                        `;
                        rowDiv.appendChild(cell);
                    }
                });

                container.appendChild(rowDiv);
            });
        }

        function toggleElement(sym) {
            if (selectedElements.includes(sym)) {
                if (selectedElements.length <= 1) return;
                selectedElements = selectedElements.filter(s => s !== sym);
            } else {
                selectedElements.push(sym);
            }
            selectedElements.sort((a, b) => MAIN_ELEMENTS[a].z - MAIN_ELEMENTS[b].z);
            updateCompareTab();
        }

        function applyPreset(arr) {
            selectedElements = [...arr];
            updateCompareTab();
        }

        function clearSelection() {
            selectedElements = ["Na", "Mg"];
            updateCompareTab();
        }

        /* ==========================================================================
           RENDER COMPARES & EXPLANATIONS
           ========================================================================== */
        function updateCompareTab() {
            renderFullPTable();
            document.getElementById('selected-badge').innerText = `Đã chọn: ${selectedElements.length} nguyên tố`;

            renderRelationshipAnalysis();
            renderElectronCards();
            renderCSSCharts();
            renderCompareTable();
        }

        function renderRelationshipAnalysis() {
            const title = document.getElementById('relation-title');
            const desc = document.getElementById('relation-desc');

