      { q: "Công thức oxide cao nhất của phosphorus thuộc nhóm VA là gì?", opts: ["PO", "P₂O₃", "PO₂", "P₂O₅"], c: 3, exp: "P có số oxi hóa cao nhất +5. Công thức oxide thường dùng trong chương trình phổ thông là P₂O₅." },
