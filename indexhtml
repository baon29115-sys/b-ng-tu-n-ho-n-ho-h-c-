<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChemCompare Pro - Bảng Tuần Hoàn Nhóm A (7 Chu Kỳ)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .bg-grid { background-size: 20px 20px; background-image: radial-gradient(circle, #cbd5e1 1px, transparent 1px); }
        .bar-animate { transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
        .custom-scrollbar::-webkit-scrollbar { height: 6px; width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 4px; }
        .site-nav { flex-wrap: wrap; }
        .site-nav > button { min-height: 44px; justify-content: center; }
        .passport-layout { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 24px; align-items: start; }
        .passport-panel { min-width: 0; padding: 20px; background: white; border: 1px solid #e2e8f0; border-radius: 20px; }
        .passport-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
        .passport-choice { min-width: 0; min-height: 82px; padding: 8px 3px; border: 1px solid #cbd5e1; border-radius: 12px; background: #f8fafc; color: #334155; text-align: center; transition: background .15s, border-color .15s; }
        .passport-choice:hover { background: #eef2ff; border-color: #818cf8; }
        .passport-choice[aria-pressed="true"] { background: #4338ca; color: white; border-color: #4338ca; box-shadow: 0 3px 8px #4338ca26; }
        .passport-choice:focus-visible, .passport-action:focus-visible { outline: 3px solid #f59e0b; outline-offset: 3px; }
        .passport-number { display: block; font-size: 10px; opacity: .75; }
        .passport-symbol { display: block; font-size: 24px; line-height: 1.2; font-weight: 800; }
        .passport-name { display: block; overflow: hidden; text-overflow: ellipsis; font-size: 9px; white-space: nowrap; margin-top: 4px; }
        .passport-viewer { scroll-margin-top: 160px; }
        .passport-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 16px 0; }
        .passport-facts > div { min-width: 0; border-radius: 10px; padding: 10px; background: #f1f5f9; font-size: 12px; overflow-wrap: anywhere; }
        .passport-facts dt { color: #64748b; font-size: 11px; margin-bottom: 4px; }
        .passport-facts dd { font-weight: 700; }
        .passport-image { display: block; width: 100%; height: auto; max-width: 560px; margin: auto; border-radius: 8px; }
        .passport-action { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 12px; border-radius: 10px; font-size: 12px; font-weight: 700; background: #eef2ff; color: #3730a3; }
        .passport-action:disabled { opacity: .4; cursor: default; }
        @media (max-width: 767px) {
            .site-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
            .site-nav > button { padding: 8px 6px; font-size: 11px; }
            .passport-layout { grid-template-columns: minmax(0, 1fr); gap: 16px; }
            .passport-panel { padding: 14px; }
            .passport-viewer { scroll-margin-top: 195px; }
        }
        @media (max-width: 359px) { .passport-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col bg-grid">

    <!-- HEADER -->
    <header class="bg-indigo-700 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center space-x-3">
                <div class="bg-white text-indigo-700 p-2 rounded-xl shadow-md font-black text-xl flex items-center justify-center">
                    🧪
                </div>
                <div>
                    <h1 class="text-xl font-black tracking-tight">ChemCompare Pro 7P</h1>
                    <p class="text-xs text-indigo-200 font-medium">Bảng Tuần Hoàn Đầy Đủ Các Nguyên Tố Nhóm A (Chu Kỳ 1 - 7)</p>
                </div>
            </div>

            <!-- TAB MENU -->
            <nav class="site-nav flex bg-indigo-800/60 p-1 rounded-xl gap-1" aria-label="Chức năng học tập">
                <button id="tab-btn-compare" onclick="switchTab('compare')" class="tab-btn px-3.5 py-1.5 rounded-lg font-bold text-xs sm:text-sm bg-white text-indigo-800 shadow-sm transition-all flex items-center gap-1.5">
                    🔍 So Sánh Nguyên Tố
                </button>
                <button id="tab-btn-game" onclick="switchTab('game')" class="tab-btn px-3.5 py-1.5 rounded-lg font-bold text-xs sm:text-sm text-indigo-100 hover:text-white transition-all flex items-center gap-1.5">
                    🎮 Trò Chơi Sắp Xếp
                </button>
                <button id="tab-btn-quiz" onclick="switchTab('quiz')" class="tab-btn px-3.5 py-1.5 rounded-lg font-bold text-xs sm:text-sm text-indigo-100 hover:text-white transition-all flex items-center gap-1.5">
                    📝 Trắc Nghiệm
                </button>
                <button id="tab-btn-passport" onclick="switchTab('passport')" class="tab-btn px-3.5 py-1.5 rounded-lg font-bold text-xs sm:text-sm text-indigo-100 hover:text-white transition-all flex items-center gap-1.5">
                    🛂 Hộ Chiếu Nguyên Tố
                </button>
            </nav>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl w-full mx-auto px-3 sm:px-6 py-5 flex-grow space-y-6">

        <!-- ==================== TAB 1: SO SÁNH NGUYÊN TỐ ==================== -->
        <section id="tab-compare" class="space-y-6">
            
            <!-- BẢNG TUẦN HOÀN 7 CHU KỲ NHÓM A -->
            <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-sm space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
                    <div>
                        <h2 class="text-base font-extrabold text-slate-800 flex items-center gap-2">
                            <span>📌</span> Bảng Tuần Hoàn Nhóm A Đầy Đủ (7 Chu Kỳ)
                        </h2>
                        <p class="text-xs text-slate-500 font-medium">Bấm trực tiếp vào các ô nguyên tố từ Chu kỳ 1 đến Chu kỳ 7 để chọn so sánh!</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="clearSelection()" class="text-xs bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold px-3 py-1.5 rounded-lg border border-rose-200 transition-colors">
                            🗑 Bỏ chọn tất cả
                        </button>
                        <span id="selected-badge" class="text-xs bg-indigo-100 text-indigo-800 font-extrabold px-3 py-1.5 rounded-lg border border-indigo-200">
